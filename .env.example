# Omit VITE_DATA_BACKEND to use the original browser-only prototype.
VITE_DATA_BACKEND=http
DATABASE_URL=postgres://flyerrr:flyerrr_dev@127.0.0.1:55432/flyerrr
APP_ORIGIN=http://localhost:8080

# Only for a hosted database that uses its own certificate authority (Supabase staging).
# Paste the certificate, and leave sslmode out of DATABASE_URL. See docs/deploy-staging.md.
# DATABASE_SSL_CA=
